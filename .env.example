# Release signing — EXAMPLE. These are read by packaging/build.ps1 and the release workflow.
# Locally: copy to `.env` (git-ignored) and load it into your shell, or set them as
# environment variables. In GitHub: add them as Actions secrets / variables (RELEASE_SETUP.md).
# Never commit real values. Use one signing method.

# --- Option A: a .pfx code-signing certificate
NOTCHLY_PFX_BASE64=base64-of-the-pfx-file
NOTCHLY_PFX_PASSWORD=replace-me

# --- Option B: Azure Trusted Signing
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-me
TRUSTED_SIGNING_ENDPOINT=https://eus.codesigning.azure.net
TRUSTED_SIGNING_ACCOUNT=replace-me
TRUSTED_SIGNING_PROFILE=replace-me

# --- Option C: SignPath
SIGNPATH_API_TOKEN=replace-me
SIGNPATH_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
SIGNPATH_PROJECT_SLUG=notchly
SIGNPATH_POLICY_SLUG=release-signing

# RFC 3161 timestamp server (optional; DigiCert's is the default)
NOTCHLY_TIMESTAMP_URL=http://timestamp.digicert.com

# Update manifest signing key (PRIVATE; from packaging/update-key.ps1)
NOTCHLY_UPDATE_SIGNING_KEY=base64-of-96-bytes-private-key
