# Release signing: EXAMPLE. Read by packaging/build.ps1 and the release workflow.
# Locally: copy to `.env` (git-ignored) and load it into your shell, or set them as
# environment variables. In GitHub: add them as Actions secrets / variables (RELEASE_SETUP.md).
# Never commit real values. Everything here is OPTIONAL: on the zero-cost path none of it
# is set and the Microsoft Store signs the Store package. See docs/KEYS_AND_SECRETS.md.

# Update manifest signing key (PRIVATE; from packaging/update-key.ps1). GitHub secret.
NOTCHLY_UPDATE_SIGNING_KEY=base64-of-96-bytes-private-key

# --- Optional: SignPath Foundation (free, only for OSI-licensed open source)
SIGNPATH_API_TOKEN=replace-me
SIGNPATH_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
SIGNPATH_PROJECT_SLUG=notchly
SIGNPATH_POLICY_SLUG=release-signing

# --- Optional: a .pfx code-signing certificate, if you ever have one
NOTCHLY_PFX_BASE64=base64-of-the-pfx-file
NOTCHLY_PFX_PASSWORD=replace-me
# RFC 3161 timestamp server (DigiCert's is the default)
NOTCHLY_TIMESTAMP_URL=http://timestamp.digicert.com
